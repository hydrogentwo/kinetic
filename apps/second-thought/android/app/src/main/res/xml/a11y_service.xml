<?xml version="1.0" encoding="utf-8"?>
<!--
  The accessibility service's scope.

  canRetrieveWindowContent is what lets it read a screen; there is no narrower
  permission. The mitigations are all in code: the package allowlist is checked
  before a node is touched, and password fields are skipped. Note there is no
  `android:canPerformGestures` and no `android:canRequestFilterKeyEvents` - the
  service cannot click, swipe, or see what the person types on a keyboard it
  does not own. That is deliberate.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="300"
    android:packageNames="com.whatsapp,com.whatsapp.w4b,com.discord,com.google.android.apps.messaging,com.android.mms,com.samsung.android.messaging,com.textra,com.Slack,com.SlackEnterprise,com.microsoft.teams,com.instagram.android,org.telegram.messenger,org.telegram.plus,org.thunderdog.challegram,com.facebook.orca,com.facebook.mlite,org.thoughtcrime.securesms,com.linkedin.android" />
